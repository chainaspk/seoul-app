function previewReceipt(){
  const file=document.getElementById('b-receipt').files[0];
  if(!file){ curReceipt=null; return; }
  const reader=new FileReader();
  reader.onload=ev=>{
    const img=new Image();
    img.onload=()=>{
      const maxW=500;
      const scale=Math.min(1,maxW/img.width);
      const canvas=document.createElement('canvas');
      canvas.width=img.width*scale; canvas.height=img.height*scale;
      canvas.getContext('2d').drawImage(img,0,0,canvas.width,canvas.height);
      curReceipt=canvas.toDataURL('image/jpeg',0.55);
      const prev=document.getElementById('receipt-preview');
      prev.src=curReceipt; prev.style.display='block';
    };
    img.src=ev.target.result;
  };
  reader.readAsDataURL(file);
}
function addExpense(){
  const cat=document.getElementById('b-cat').value;
  const amount=Number(document.getElementById('b-amount').value);
  if(!amount||amount<=0) return;
  const obj = sheetMode==='predep' ? predepData : budgetData[curMonth];
  obj[cat].expenses.push({id:Date.now().toString(),amount,desc:document.getElementById('b-desc').value.trim(),date:new Date().toISOString(),img:curReceipt});
  document.getElementById('b-amount').value=''; document.getElementById('b-desc').value='';
  document.getElementById('b-receipt').value=''; document.getElementById('receipt-preview').style.display='none'; curReceipt=null;
  openCat=cat; openSource=sheetMode;
  save(); renderBudgetLike(sheetMode); closeSheets();
}

