<title>Séoul ✨</title>
<style>
:root{
  --pink:#e88fb5; --pink-d:#c96f96; --lav:#b9a6e0;
  --bg:#fdf7fa; --card:#ffffff; --text:#33262e; --muted:#8a7b84; --border:#f0dfe8;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
:root:not([data-theme="light"]){
  @media (prefers-color-scheme: dark){
    --bg:#221b20; --card:#2c232a; --text:#f3e9ee; --muted:#b09aa8; --border:#3c2f38;
  }
}
:root[data-theme="dark"]{
  --bg:#221b20; --card:#2c232a; --text:#f3e9ee; --muted:#b09aa8; --border:#3c2f38;
}
html{scroll-padding-top:env(safe-area-inset-top,0px); height:100%;}
*{box-sizing:border-box;}
body{margin:0;height:100%;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;}
header{position:sticky;top:0;padding:calc(14px + env(safe-area-inset-top,0px)) 16px 10px;background:var(--bg);z-index:5;border-bottom:1px solid var(--border);}
h1{margin:0 0 10px;font-size:1.3rem;display:flex;align-items:center;gap:8px;}
.tabs{display:flex;gap:6px;}
.tab{flex:1;padding:9px 6px;border-radius:12px;text-align:center;font-size:.85rem;font-weight:600;background:var(--card);color:var(--muted);border:1px solid var(--border);cursor:pointer;}
.tab.active{background:var(--pink);color:#fff;border-color:var(--pink);}
main{padding:14px 16px 90px;max-width:520px;margin:0 auto;}
.view{display:none;}
.view.active{display:block;}
.chips{display:flex;gap:6px;overflow-x:auto;padding-bottom:8px;margin-bottom:12px;}
.chip{flex:none;padding:6px 12px;border-radius:20px;font-size:.78rem;border:1px solid var(--border);background:var(--card);color:var(--muted);cursor:pointer;white-space:nowrap;}
.chip.active{background:var(--lav);color:#fff;border-color:var(--lav);}
.cat-group{margin-bottom:16px;}
.cat-title{font-size:.75rem;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin:0 0 6px 2px;}
.item{display:flex;align-items:center;gap:10px;background:var(--card);border:1px solid var(--border);border-radius:14px;padding:10px 12px;margin-bottom:7px;}
.item.done{opacity:.5;}
.item.done .item-name{text-decoration:line-through;}
.item-check{width:20px;height:20px;border-radius:50%;border:2px solid var(--pink);flex:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.7rem;color:#fff;}
.item.done .item-check{background:var(--pink);}
.item-body{flex:1;min-width:0;}
.item-name{font-weight:600;font-size:.92rem;}
.item-note{font-size:.78rem;color:var(--muted);}
.del{background:none;border:none;color:var(--muted);font-size:1.1rem;cursor:pointer;padding:2px 6px;}
.map-btn{flex:none;width:34px;height:34px;border-radius:50%;background:#03c75a1a;color:#03c75a;display:flex;align-items:center;justify-content:center;font-size:1rem;text-decoration:none;}
.item-link{flex:none;width:34px;height:34px;border-radius:50%;background:#e88fb51a;color:var(--pink-d);display:flex;align-items:center;justify-content:center;font-size:1rem;text-decoration:none;}
.item-price{flex:none;font-size:.78rem;font-weight:700;color:var(--pink-d);}
.tip-note{font-size:.82rem;color:var(--muted);margin-top:2px;}
.td-cat{display:inline-block;font-size:.72rem;background:var(--lav);color:#fff;padding:3px 10px;border-radius:20px;margin-bottom:8px;}
.td-note{font-size:.9rem;line-height:1.5;white-space:pre-line;margin-bottom:14px;}
.td-check{display:flex;align-items:flex-start;gap:10px;padding:8px 0;border-bottom:1px solid var(--border);cursor:pointer;}
.td-check .box{width:20px;height:20px;border-radius:6px;border:2px solid var(--pink);flex:none;display:flex;align-items:center;justify-content:center;font-size:.7rem;color:#fff;margin-top:1px;}
.td-check.done .box{background:var(--pink);}
.td-check.done span{text-decoration:line-through;color:var(--muted);}
.td-linkbtn{display:flex;align-items:center;gap:8px;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:10px 12px;margin-bottom:8px;text-decoration:none;color:var(--text);font-size:.88rem;font-weight:600;}
.td-section-title{font-size:.75rem;text-transform:uppercase;color:var(--muted);letter-spacing:.04em;margin:14px 0 8px;}
.item{cursor:pointer;}
.empty{color:var(--muted);font-size:.85rem;text-align:center;padding:30px 10px;}
.fab{position:fixed;bottom:calc(20px + env(safe-area-inset-bottom,0px));right:20px;width:54px;height:54px;border-radius:50%;background:var(--pink);color:#fff;border:none;font-size:1.6rem;box-shadow:0 6px 16px rgba(200,100,140,.4);cursor:pointer;z-index:6;}
.sheet-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:10;}
.sheet-bg.active{display:block;}
.sheet{position:fixed;left:0;right:0;bottom:0;background:var(--card);border-radius:20px 20px 0 0;padding:18px 16px calc(18px + env(safe-area-inset-bottom,0px));z-index:11;transform:translateY(100%);transition:.25s;max-width:520px;margin:0 auto;}
.sheet-bg.active .sheet{transform:translateY(0);}
.sheet h3{margin:0 0 12px;}
.field{margin-bottom:10px;}
.field label{display:block;font-size:.78rem;color:var(--muted);margin-bottom:4px;}
.field input,.field select,.field textarea{width:100%;padding:10px 12px;border-radius:10px;border:1px solid var(--border);background:var(--bg);color:var(--text);font-size:.9rem;}
.sheet-actions{display:flex;gap:8px;margin-top:14px;}
.btn{flex:1;padding:11px;border-radius:12px;border:none;font-weight:600;font-size:.9rem;cursor:pointer;}
.btn-primary{background:var(--pink);color:#fff;}
.btn-secondary{background:var(--bg);color:var(--muted);border:1px solid var(--border);}
.budget-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:14px;margin-bottom:10px;}
.budget-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;}
.budget-cat{font-weight:700;}
.budget-nums{font-size:.8rem;color:var(--muted);}
.bar-bg{height:8px;border-radius:6px;background:var(--border);overflow:hidden;}
.bar-fill{height:100%;background:var(--pink);}
.bar-fill.over{background:#d9534f;}
.summary{background:linear-gradient(135deg,var(--pink),var(--lav));color:#fff;border-radius:16px;padding:16px;margin-bottom:16px;}
.summary .big{font-size:1.5rem;font-weight:700;}
.summary .row{display:flex;justify-content:space-between;font-size:.85rem;margin-top:6px;opacity:.95;}
select option{color:#000;}
.month-picker{display:flex;align-items:center;gap:8px;margin-bottom:14px;}
.month-picker input{flex:1;padding:9px 10px;border-radius:10px;border:1px solid var(--border);background:var(--card);color:var(--text);font-size:.9rem;}
.month-picker button{background:var(--card);border:1px solid var(--border);color:var(--muted);border-radius:10px;width:36px;height:36px;font-size:1.1rem;cursor:pointer;}
.expenses{display:none;margin-top:10px;border-top:1px solid var(--border);padding-top:8px;}
.expenses.open{display:block;}
.exp-row{display:flex;align-items:center;gap:8px;padding:5px 0;font-size:.82rem;}
.exp-thumb{width:34px;height:34px;border-radius:8px;object-fit:cover;flex:none;background:var(--bg);}
.exp-info{flex:1;min-width:0;}
.exp-desc{color:var(--muted);font-size:.75rem;}
.receipt-preview{width:60px;height:60px;border-radius:10px;object-fit:cover;margin-top:6px;display:none;}
</style>
</head>
