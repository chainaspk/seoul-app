function renderChips(){
  const el=document.getElementById('itin-chips');
  const cats=["Tout",...ITIN_CATS];
  el.innerHTML=cats.map(c=>`<div class="chip ${c===curFilter?'active':''}" onclick="setFilter('${c}')">${c==="Tout"?t('tout'):catLabel(c)}</div>`).join('')
    +`<div class="chip" onclick="manageCats()" style="border-style:dashed">${t('manageCats')}</div>`;
}
function setFilter(c){ curFilter=c; renderChips(); renderItin(); }
function manageCats(){
  const action=prompt("Tape le nom d'une NOUVELLE catégorie à ajouter,\nou le nom exact d'une catégorie existante pour la SUPPRIMER.\n\nActuelles : "+ITIN_CATS.join(', '));
  if(!action) return;
  const name=action.trim();
  const i=ITIN_CATS.indexOf(name);
  if(i>-1){
    if(itin.some(t=>t.cat===name)){ alert("Impossible : des éléments utilisent encore cette catégorie."); return; }
    ITIN_CATS.splice(i,1);
    if(curFilter===name) curFilter="Tout";
  } else { ITIN_CATS.push(name); }
  save(); renderChips(); renderItin();
}

function renderItin(){
  const list=document.getElementById('itin-list');
  const cats = curFilter==="Tout" ? ITIN_CATS : [curFilter];
  let html='';
