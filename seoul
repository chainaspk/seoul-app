  cats.forEach(cat=>{
    const items=itin.filter(i=>i.cat===cat);
    if(items.length===0) return;
    any=true;
    html+=`<div class="cat-group"><div class="cat-title">${catLabel(cat)}</div>`;
    items.forEach(i=>{
      const query=encodeURIComponent(i.place||i.name);
