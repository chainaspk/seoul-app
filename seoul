function renderBudgetLike(source){
  const cats = source==='predep' ? PRE_CATS : BUD_CATS;
  const dataObj = source==='predep' ? predepData : budgetData[curMonth];
  const listId = source==='predep' ? 'predep-list' : 'budget-list';
  const summaryId = source==='predep' ? 'predep-summary' : 'budget-summary';
  let totalLimit=0, totalSpent=0;
  const list=document.getElementById(listId);
  let html='';
  cats.forEach(cat=>{
    const b=dataObj[cat];
    const spent=b.expenses.reduce((s,e)=>s+e.amount,0);
    totalLimit+=Number(b.limit)||0; totalSpent+=spent;
    const pct = b.limit>0 ? Math.min(100,(spent/b.limit)*100) : (spent>0?100:0);
    const over = b.limit>0 && spent>b.limit;
    const isOpen = openCat===cat && openSource===source;
    html+=`<div class="budget-card">
      <div class="budget-top" style="cursor:pointer" onclick="toggleCat('${source}','${cat}')">
        <span class="budget-cat">${catLabel(cat)} ${b.expenses.length?`<span style="color:var(--muted);font-weight:400;font-size:.75rem">(${b.expenses.length})</span>`:''}</span>
        <input type="number" inputmode="decimal" style="width:80px;text-align:right;padding:5px 8px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--text);font-size:.85rem;" value="${b.limit||''}" placeholder="${source==='predep'?t('estimated'):t('tabBudget')}" onclick="event.stopPropagation()" onchange="setLimit('${source}','${cat}',this.value)">
      </div>
      <div class="bar-bg"><div class="bar-fill ${over?'over':''}" style="width:${pct}%"></div></div>
      <div class="budget-nums">${spent.toFixed(0)} € ${t('spent')} ${b.limit>0?`/ ${Number(b.limit).toFixed(0)} € ${source==='predep'?t('estimated'):''}`:''}</div>
      <div class="expenses ${isOpen?'open':''}">${b.expenses.length? b.expenses.map(e=>`
        <div class="exp-row">
          ${e.img?`<img class="exp-thumb" src="${e.img}">`:'<div class="exp-thumb"></div>'}
          <div class="exp-info">${e.desc?escapeHtml(e.desc):`<span class="exp-desc">${t('noDesc')}</span>`}<div class="exp-desc">${new Date(e.date).toLocaleDateString(LANG==='ko'?'ko-KR':LANG==='en'?'en-US':'fr-FR')}</div></div>
          <div>${e.amount.toFixed(0)} €</div>
          <button class="del" onclick="delExpense('${source}','${cat}','${e.id}')">×</button>
        </div>`).join('') : `<div class="exp-desc">${source==='predep'?t('noExpPre'):t('noExpMonth')}</div>`}</div>
    </div>`;
  });
  list.innerHTML=html;
  const remain=totalLimit-totalSpent;
  let head='';
  if(source==='predep'){
    head=`<div class="row" style="margin-top:0"><span>${t('predepHead')}</span><span></span></div>`;
  }else{
    const [y,m]=curMonth.split('-');
    const label=new Date(y,m-1,1).toLocaleDateString(LANG==='ko'?'ko-KR':LANG==='en'?'en-US':'fr-FR',{month:'long',year:'numeric'});
    head=`<div class="row" style="margin-top:0;text-transform:capitalize"><span>${label}</span><span></span></div>`;
  }
  const parts=cats.map(c=>({name:c,val:dataObj[c].expenses.reduce((s,e)=>s+e.amount,0)})).filter(p=>p.val>0);
  const palette=['#e88fb5','#b9a6e0','#f0b7a0','#8fd0c4','#f2d17c','#a8c4ea','#d99fc9','#9fd9a8'];
  let pie='';
  if(parts.length){
    let acc=0, segs='', legend='';
    parts.forEach((p,idx)=>{
      const frac=p.val/totalSpent, dash=frac*100, col=palette[idx%palette.length];
      segs+=`<circle r="15.9" cx="18" cy="18" fill="none" stroke="${col}" stroke-width="6"
        stroke-dasharray="${dash.toFixed(2)} ${(100-dash).toFixed(2)}" stroke-dashoffset="${(25-acc).toFixed(2)}"/>`;
      legend+=`<div style="display:flex;align-items:center;gap:5px;font-size:.72rem;margin-bottom:2px">
        <span style="width:9px;height:9px;border-radius:2px;background:${col};flex:none"></span>
        <span style="flex:1">${catLabel(p.name)}</span><b>${Math.round(frac*100)}%</b></div>`;
      acc+=dash;
    });
    pie=`<div style="display:flex;gap:12px;align-items:center;margin-top:12px;padding-top:12px;border-top:1px solid rgba(255,255,255,.3)">
      <svg viewBox="0 0 36 36" style="width:88px;height:88px;flex:none;transform:rotate(-90deg)">${segs}</svg>
      <div style="flex:1;min-width:0">${legend}</div></div>`;
  }
  document.getElementById(summaryId).innerHTML=`${head}
    <div class="big">${totalSpent.toFixed(0)} € ${t('spent')}</div>
    <div class="row"><span>${source==='predep'?t('estTotal'):t('budgetTotal')}</span><span>${totalLimit.toFixed(0)} €</span></div>
    <div class="row"><span>${t('remain')}</span><span>${remain.toFixed(0)} €</span></div>${pie}`;
}
